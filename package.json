{
  "name": "dyn-gui-lang",
  "displayName": "DynamicGUI for Minecraft",
  "description": "DynamicGUI language support for Minecraft modding",
  "version": "0.0.1",
  "publisher": "Zavrikzz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zavrikzz/DynamicGUI-for-Minecraft.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:mygui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "mygui",
      "aliases": ["MyGUI", "mygui"],
      "extensions": [".gui"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "mygui",
      "scopeName": "source.mygui",
      "path": "./syntaxes/my-gui-lang.tmLanguage.json"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}